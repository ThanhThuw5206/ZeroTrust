# Copy thành lab.env rồi thay bằng IP/DNS mà Windows client truy cập được.
ZITI_ADVERTISED_ADDRESS=192.168.198.131
ZITI_CTRL_PORT=1280
ZITI_ROUTER_PORT=3022

# Tên mặc định của all-in-one quickstart. Sửa nếu compose chính thức thay đổi.
ZITI_COMPOSE_SERVICE=quickstart
ZITI_ROUTER_NAME=quickstart-router

# Không đặt admin password trong file này. Script 01 sẽ hỏi kín và ghi vào .env
# (đã gitignore), hoặc truyền ZITI_PWD qua environment tạm thời.

